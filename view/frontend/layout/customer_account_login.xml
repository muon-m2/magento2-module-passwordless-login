<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Muon_PasswordlessLogin::css/passwordlesslogin.css"/>
    </head>
    <body>
        <referenceContainer name="customer.login.container">
            <block class="Magento\Framework\View\Element\Template"
                   name="passwordlesslogin.link"
                   after="customer.new"
                   ifconfig="muon_passwordlesslogin/general/enabled"
                   template="Muon_PasswordlessLogin::login/link.phtml"/>
        </referenceContainer>
    </body>
</page>
